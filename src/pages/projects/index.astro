---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMeta from '../../components/ProjectMeta.astro';
import ProjectLogo from '../../components/ProjectLogo.astro';
import { getPublicProjects } from '../../lib/projects';
import '../../styles/projects.css';

const projects = await getPublicProjects();
---

<BaseLayout title="PROJECTS — SHLEE.CO.UK" description="Gaming, organisations and community projects being built">
  <div class="container container--wide project-page">
    <header class="project-heading">
      <p class="eyebrow muted">The work</p>
      <h1>PROJECTS</h1>
      <p class="project-summary muted">Gaming, organisations and community projects being built</p>
    </header>
    {projects.length > 0 && (
      <ol class="project-list">
        {projects.map((project) => (
          <li>
            <article class="project-row">
              <div>
                {project.data.logo && <ProjectLogo src={project.data.logo} />}
              </div>
              <div>
                <ProjectMeta {...project.data} />
                <h2>{project.data.title}</h2>
                {project.data.summary && <p class="project-summary muted">{project.data.summary}</p>}
              </div>
            </article>
          </li>
        ))}
      </ol>
    )}
  </div>
</BaseLayout>

<style>
  .project-list { list-style: none; margin: 0; padding: 0; }
  .project-row {
    display: grid;
    grid-template-columns: 1fr 2fr;
    align-items: start;
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-top: var(--border-rule);
  }
  h2 { font-size: var(--text-large); }
  .project-summary { margin-top: var(--space-4); }
  @media (max-width: 47.999rem) {
    .project-row { grid-template-columns: 1fr; gap: var(--space-4); }
  }
</style>
