---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeProject from '../components/HomeProject.astro';
import HeroIdentity from '../components/HeroIdentity.astro';
import { getPublicProjects } from '../lib/projects';

const featured = (await getPublicProjects()).filter(project => project.data.featured);
---

<BaseLayout title="SHLEE.CO.UK — Things being made" socialDescription="Projects across creative technology, computer gaming, community activity and organisational practice.">
  <div class="container container--wide landing-page">
    <section class="hero" aria-labelledby="identity">
      <div class="hero-title"><HeroIdentity /></div>
      <div class="hero-bottom">
        <p class="hero-statement">Making ideas into things.</p>
        {featured.length > 0 && <div class="hero-context">
          <a class="text-link" href="/projects">Explore the work <span aria-hidden="true">↗</span></a>
        </div>}
      </div>
    </section>

    {featured.length > 0 && <section class="work-section" aria-labelledby="projects-heading">
      <div class="section-heading">
        <h2 id="projects-heading">Projects</h2>
        <a class="text-link" href="/projects">All projects <span aria-hidden="true">↗</span></a>
      </div>
      <div class="featured-work">
        {featured.map(project => <HomeProject project={project} />)}
      </div>
    </section>}

    <section class="introduction editorial-row" aria-labelledby="about-heading">
      <h2 id="about-heading" class="eyebrow">Behind the work</h2>
      <div>
        <p class="intro-statement">I'm Ashley, usually Shlee.</p>
        <p class="muted intro-note">My passion is creative technology, community projects and organisational practices.</p>
        <a class="text-link" href="/about">About <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .landing-page {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .hero-statement { max-width: 18ch; }
  .hero-context { flex-shrink: 0; }
  .featured-work {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .introduction .text-link { margin-top: var(--space-3); }
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
    /* Target 48% of the previous height. Normal flow keeps full-size text
       from overlapping when its natural height exceeds that target. */
    min-height: max(
      31.2svh,
      calc(var(--text-display) * 0.816 + var(--text-large) * 1.44 + var(--space-3) * 1.44),
      calc(var(--text-large) * 4.8 + var(--space-3) * 1.44)
    );
  }
  .hero-title :global(#identity) { margin-block: 0; }
  .hero-bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    align-items: end;
  }
  .hero-statement, .intro-statement {
    font-size: var(--text-large);
    line-height: var(--leading-heading);
    letter-spacing: -0.035em;
  }
  .hero-context {
    max-width: 24rem;
    color: var(--color-text-muted);
  }
  .hero-context .text-link {
    margin-top: var(--space-3);
  }
  .editorial-row {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-5);
    border-top: var(--border-rule);
  }
  .work-section {
    padding-block: var(--space-6) var(--space-7);
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .section-heading h2 {
    font-size: var(--text-heading);
  }
  .introduction {
    /* Use spare viewport space above the whole section, keeping its divider attached. */
    margin-top: auto;
    padding-block: var(--space-6) var(--space-7);
  }
  .intro-note {
    margin-top: var(--space-4);
    max-width: var(--reading-width);
  }

  @media (max-width: 47.99rem) {
    .hero-bottom {
      align-items: start;
      flex-direction: column;
      gap: var(--space-4);
    }
    .editorial-row {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .featured-work {
      grid-template-columns: 1fr;
    }
    .section-heading {
      flex-wrap: wrap;
    }
  }
</style>
