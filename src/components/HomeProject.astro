---
import ProjectLogo from './ProjectLogo.astro';
import { type Project } from '../lib/projects';

interface Props { project: Project }
const { project } = Astro.props;
---

<article class="home-project">
  {project.data.logo && <ProjectLogo src={project.data.logo} />}
  <div class="project-caption">
    <h3>{project.data.title}</h3>
    <div class="project-copy">
      {(project.data.homepageSummary ?? project.data.summary) &&
        <p class="muted">{project.data.homepageSummary ?? project.data.summary}</p>}
    </div>
  </div>
</article>

<style>
  .home-project { min-width: 0; overflow-wrap: anywhere; }
  .project-caption {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-4);
  }
  h3 { font-size: var(--text-heading); }
  .project-copy { display: grid; gap: var(--space-3); min-width: 0; }
  .project-copy p { max-width: var(--reading-width); }
</style>
